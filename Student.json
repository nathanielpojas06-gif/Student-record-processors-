// ==========================================
// 2. REQUIRED FUNCTIONS
// ==========================================

/**
 * Calculates the average grade of a student.
 * Uses: Array.prototype.reduce
 */
function getAverageGrade(student) {
  if (!student || typeof student !== 'object') {
    throw new Error("Invalid argument: Expected a student object.");
  }
  if (!student.grades || student.grades.length === 0) {
    return 0; // Edge case handling
  }
  
  const sum = student.grades.reduce((acc, curr) => acc + curr, 0);
  return Number((sum / student.grades.length).toFixed(2));
}

/**
 * Returns top N students sorted by average grade descending.
 * Uses: Array.prototype.map, sort, slice
 */
function getTopStudents(studentsArray, n) {
  if (!Array.isArray(studentsArray)) {
    throw new Error("Invalid argument: First parameter must be an array.");
  }
  if (typeof n !== 'number' || n < 0) {
    throw new Error("Invalid argument: 'n' must be a non-negative number.");
  }

  return [...studentsArray]
    .map(student => ({ ...student, averageGrade: getAverageGrade(student) }))
    .sort((a, b) => b.averageGrade - a.averageGrade)
    .slice(0, n);
}

/**
 * Groups students by their course.
 * Uses: Array.prototype.reduce
 */
function groupByCourse(studentsArray) {
  if (!Array.isArray(studentsArray)) {
    throw new Error("Invalid argument: Expected an array.");
  }

  return studentsArray.reduce((acc, student) => {
    const course = student.course || "Unassigned";
    if (!acc[course]) {
      acc[course] = [];
    }
    acc[course].push(student);
    return acc;
  }, {});
}

/**
 * Counts enrolled vs non-enrolled students.
 * Uses: Array.prototype.reduce
 */
function getEnrolledCount(studentsArray) {
  if (!Array.isArray(studentsArray)) {
    throw new Error("Invalid argument: Expected an array.");
  }

  return studentsArray.reduce((acc, student) => {
    if (student.enrolled) {
      acc.enrolled += 1;
    } else {
      acc.notEnrolled += 1;
    }
    return acc;
  }, { enrolled: 0, notEnrolled: 0 });
}

/**
 * Performs a case-insensitive search for a student by name.
 * Uses: Array.prototype.find
 */
function findStudent(studentsArray, name) {
  if (!Array.isArray(studentsArray) || typeof name !== 'string') {
    throw new Error("Invalid arguments: Expected an array and a string name.");
  }

  const result = studentsArray.find(
    student => student.name.toLowerCase() === name.toLowerCase().trim()
  );

  return result || null; // Edge case handling
}

/**
 * Calculates average grade per course, sorted highest to lowest.
 * Uses: Array.prototype.map, sort
 */
function getCourseAverages(studentsArray) {
  if (!Array.isArray(studentsArray)) {
    throw new Error("Invalid argument: Expected an array.");
  }

  const grouped = groupByCourse(studentsArray);

  const courseAverages = Object.keys(grouped).map(course => {
    const courseStudents = grouped[course];
    const totalAvgSum = courseStudents.reduce((sum, s) => sum + getAverageGrade(s), 0);
    const courseAvg = courseStudents.length > 0 ? totalAvgSum / courseStudents.length : 0;

    return {
      course: course,
      averageGrade: Number(courseAvg.toFixed(2))
    };
  });

  return courseAverages.sort((a, b) => b.averageGrade - a.averageGrade);
}

/**
 * Generates an overall statistical summary object.
 */
function exportSummary(studentsArray) {
  if (!Array.isArray(studentsArray)) {
    throw new Error("Invalid argument: Expected an array.");
  }
  if (studentsArray.length === 0) {
    return { totalStudents: 0, overallAverage: 0, topStudent: null, courseBreakdown: [] };
  }

  const totalStudents = studentsArray.length;
  
  const totalSum = studentsArray.reduce((acc, s) => acc + getAverageGrade(s), 0);
  const overallAverage = Number((totalSum / totalStudents).toFixed(2));

  const topStudent = getTopStudents(studentsArray, 1)[0] || null;
  const courseBreakdown = getCourseAverages(studentsArray);

  return {
    totalStudents,
    overallAverage,
    topStudent: topStudent ? { name: topStudent.name, averageGrade: topStudent.averageGrade } : null,
    courseBreakdown
  };
}

// ==========================================
// 3. STRETCH GOALS (EXTRA CREDIT)
// ==========================================

/**
 * Filters students by year level.
 * Uses: Array.prototype.filter
 */
function filterByYear(studentsArray, year) {
  if (!Array.isArray(studentsArray) || typeof year !== 'number') {
    throw new Error("Invalid arguments: Expected an array and a year number.");
  }
  return studentsArray.filter(student => student.year === year);
}

/**
 * Sorts students alphabetically by name.
 * Uses: Array.prototype.sort
 */
function sortByName(studentsArray) {
  if (!Array.isArray(studentsArray)) {
    throw new Error("Invalid argument: Expected an array.");
  }
  return [...studentsArray].sort((a, b) => a.name.localeCompare(b.name));
}

