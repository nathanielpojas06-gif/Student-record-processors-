  // Year Filter Demo
  const year2Students = filterByYear(students, 2);
  console.log(`Students in Year 2 Count : ${year2Students.length}`);

  // Alphabetical Sort Demo (First 3)
  const sortedNames = sortByName(students).slice(0, 3).map(s => s.name);
  console.log(`First 3 Students Alphabetically: ${sortedNames.join(", ")}\n`);

  // 6. Edge Cases Testing
  console.log("--- 6. EDGE CASES TEST ---");
  
  // Search for non-existent student
  const searchResult = findStudent(students, "Ghost User");
  console.log(`Search 'Ghost User'      : ${searchResult === null ? "null (Handled Correctly)" : searchResult}`);

  // Empty grades student average
  const emptyStudent = students.find(s => s.grades.length === 0);
  console.log(`Empty Grades Student Avg : ${getAverageGrade(emptyStudent)} (Handled Correctly)`);

  // Input Validation Error Catch
  try {
    getTopStudents(students, -5);
  } catch (err) {
    console.log(`Validation Check         : Handled Error -> "${err.message}"`);
  }

  console.log("\n==================================================");
  console.log("               END OF REPORT                      ");
  console.log("==================================================");
}

